{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["grype"],
  "ignore": [".trunk/**"],
  "workspaces": {
    ".": {
      "entry": ["stylelint.config.mjs"],
      "project": [
        "**/*.{js,cjs,mjs,ts,cts,mts}",
        "!packages/**",
        "!examples/**",
        "!.trunk/**",
        "!node_modules/**"
      ]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "examples/local-self-improvement": {
      "entry": ["src/demo.ts"],
      "project": ["src/**/*.ts"]
    },
    "examples/*": {
      "project": ["src/**/*.ts"]
    }
  }
}
