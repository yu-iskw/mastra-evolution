{
  "compilerOptions": {
    "target": "es2016",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  }
}
