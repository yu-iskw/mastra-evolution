# PostgreSQL for Evolution transactional state (evidence, lessons, proposals, events).
# Do NOT point this at a Cloud Storage FUSE mount or a SQLite/LibSQL file on GCS.
DATABASE_URL=postgres://user:pass@host:5432/evolution

# Object bucket for skill artifacts / workspace blobs (not a database).
ARTIFACT_BUCKET=gs://your-evolution-artifacts

# Workspace filesystem root. On Cloud Run this may be a GCS FUSE mount for
# artifacts only — never put Evolution SQLite/LibSQL state on that mount.
WORKSPACE_DIR=.workspace

# Mastra runtime (A2A / Cloud / agent endpoint). Evolution consumes thread and
# resource ids from Mastra; it does not invent a parallel transport.
MASTRA_CLOUD_ACCESS_TOKEN=
MASTRA_AGENTS_BASE_URL=
MASTRA_A2A_PATH=/a2a

# Optional model keys. This example typechecks without them and skips listen
# when DATABASE_URL is unset. PORT defaults to 8080 (Cloud Run).
PORT=8080
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
